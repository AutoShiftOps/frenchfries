# Clerk — from your Clerk app's Configure → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# Secret key — SERVER-SIDE ONLY, never prefix with VITE_. Used by the two
# /api Azure-proxy functions to cryptographically verify a caller's Clerk
# session token (api/_lib/verifyCaller.js).
CLERK_SECRET_KEY=sk_test_xxxxx

# Production instance ONLY, and ONLY if staying on a *.vercel.app domain
# instead of a custom domain — Clerk can't verify a Vercel-owned domain with
# normal DNS records, so it routes through this app's own /__clerk proxy
# (api/__clerk/[...path].js) instead. Both must be the exact same URL (the
# "Clerk Proxy URL" Clerk's dashboard shows you under Configure → Domains):
# one exposed to the browser bundle (VITE_ prefix), one read server-side by
# the proxy function itself. Leave both unset in development — Clerk's own
# *.accounts.dev domain is used directly there, no proxy needed. Skip both
# entirely if you switch to a custom domain instead (Clerk then gives you
# plain CNAME records and no proxy is involved).
VITE_CLERK_PROXY_URL=https://your-deployed-domain.vercel.app/__clerk
CLERK_PROXY_URL=https://your-deployed-domain.vercel.app/__clerk

# Comma-separated list of extra allowed origins for anonymous (signed-out)
# calls to the Azure proxies, beyond localhost. Set this to your deployed
# domain(s), e.g. https://frenchfry.vercel.app — otherwise anonymous
# "glimpse" chapters will get a 403 from /api/tts and /api/pronunciation-assess
# in production. This is a weak, spoofable check (Origin/Referer headers)
# — it only stops naive direct-hit scraping, not a determined caller.
ALLOWED_ORIGINS=https://your-deployed-domain.vercel.app

# Supabase — from your project's Settings → API
# Auth is Clerk's job now; these are only used for the database (progress
# and attempts tables), authenticated via Supabase's Third-Party Auth
# integration with Clerk (Authentication → Sign In / Providers → Third
# Party Auth in the Supabase dashboard).
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Azure Speech — from Azure Portal → your Speech resource → Keys and Endpoint
# These two are used SERVER-SIDE ONLY (in /api functions) — never prefix with VITE_
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
